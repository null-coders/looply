# Copy this file to ".env" (same folder) and fill it in.
# Without DATABASE_URL, Looply uses a local database in data/pglite (no setup needed).

# Supabase > your project > Connect > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Time zone for "today", birthdays and reports (default: India).
# APP_TIMEZONE=Asia/Kolkata
