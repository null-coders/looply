{
  "name": "looply",
  "version": "1.0.0",
  "description": "Looply - a customer loyalty system for local shops (digital + printable loyalty cards, visit-based discounts, comeback offers, win-back coupons)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "demo": "npm run seed && npm start",
    "build": "node scripts/copy-assets.js",
    "postinstall": "node scripts/copy-assets.js",
    "test": "node --test",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "express": "^5.1.0",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0"
  }
}
